[Unit]
Description=Tianyusheng Board
After=network.target
[Service]
User=ysl
WorkingDirectory=/home/ysl/tianyusheng
Environment=TYS_DATA_DIR=/home/ysl/tianyusheng-data
Environment=PORT=8080
ExecStart=/usr/bin/node /home/ysl/tianyusheng/server/app.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ysl/tianyusheng-data
UMask=0077
[Install]
WantedBy=multi-user.target
